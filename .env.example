# ---------------------------------------------------------------------------
# Mandate configuration
#
# Copy this file to `.env` in this same directory and fill in what you have.
# Nothing here is required to start the app: with no credentials it runs with
# a local PayPal simulator and a deterministic reasoner, and says so clearly
# in the UI and on startup. Add credentials to raise fidelity.
#
#   cp .env.example .env
#   npm run doctor      # checks every value below and tells you what to fix
# ---------------------------------------------------------------------------

# --- PayPal (required for real sandbox payments) ---------------------------
# Create a sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
# Use type "Merchant" and attach your sandbox business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" or "live". Keep this on sandbox. Sandbox credentials are rejected
# by the live API and vice versa, which is the most common setup mistake.
PAYPAL_ENV=sandbox

# Where autonomous payouts actually land. Set this to a sandbox PERSONAL
# account email from https://developer.paypal.com/dashboard/accounts
# Without it, every merchant points at a placeholder and payouts will fail.
PAYPAL_PAYOUT_RECEIVER=

# Optional: override the receiver for one specific merchant. The suffix is the
# merchant id uppercased with hyphens replaced by underscores.
# MERCHANT_RECEIVER_NORTHWIND_CLOUD=sb-other@personal.example.com

# Optional: the sandbox business account that receives Orders-API funds on the
# human-approval rail. Defaults to the account that owns the app.
PAYPAL_PAYEE_EMAIL=

# Optional but recommended. Create a webhook on your sandbox app pointing at
# <public-url>/api/paypal/webhook and paste the generated id here. Without it,
# webhooks are still recorded in the audit ledger but their signatures cannot
# be verified, and unverified events are never acted on.
PAYPAL_WEBHOOK_ID=

# --- AI provider (optional) ------------------------------------------------
# With no key set, a deterministic built-in reasoner adjudicates spends. The
# whole pipeline works, but intent judgement is lexical rather than semantic.
#
# Anthropic (recommended):
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Or any OpenAI-compatible endpoint (OpenAI, Groq, Together, OpenRouter,
# vLLM, a local Ollama build). Set OPENAI_BASE_URL to point elsewhere.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Force a specific provider: anthropic | openai | builtin
# AI_PROVIDER=

# Run adjudication on a different (e.g. cheaper) model than the agent.
# AI_ADJUDICATOR_MODEL=

# --- Server ----------------------------------------------------------------
PORT=8787

# Where the browser reaches the UI. Used for CORS.
WEB_ORIGIN=http://localhost:5173

# Public base URL of THIS server. PayPal return/cancel URLs and webhook
# callbacks are built from it, so if you tunnel the server (ngrok, cloudflared)
# set this to the public https URL or the approval redirect will fail.
PUBLIC_URL=http://localhost:8787

# Default currency for seeded mandates and the catalog.
CURRENCY=USD

# Shared secret for mutating endpoints (mandates, approvals, refunds).
# Empty means unauthenticated: fine on localhost, never on a public deployment.
OPERATOR_TOKEN=

# Where the append-only audit ledger lives.
# DATA_DIR=./data

# Allow POST /api/ledger/reset. Handy for repeated demos.
ALLOW_LEDGER_RESET=true

# --- MCP server (optional) -------------------------------------------------
# Pin the mandate an external agent operates under. Strongly recommended:
# without it the agent can pick its own spending authority, which defeats the
# point. Used by `npm run mcp`.
# MANDATE_ID=mdt_...
# MANDATE_AGENT_NAME=claude-desktop
